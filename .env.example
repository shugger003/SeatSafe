# Copy to .env.local. Do not commit real secrets.

# Public site URL, no trailing slash. Used for canonical links, Paystack callbacks, and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Unused by the store. Kept so older local notes do not look like a missing setting.
DATABASE_PATH=./data/store.db

# Supabase. The URL and publishable key are public. The service role stays server-side and is never committed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the administrator session cookie. Use a long random string.
SESSION_SECRET=

# Administrator sign-in. There is no public registration page.
ADMIN_EMAIL=
# Preferred: scrypt hash from `npm run admin:hash`.
ADMIN_PASSWORD_HASH=
# Development only. Ignored when NODE_ENV=production.
ADMIN_PASSWORD=

# Payments.
# Leave unset to keep checkout from taking payment.
# Set PAYMENTS_MODE=test for the local simulator. It refuses to run in production.
# Set PAYSTACK_SECRET_KEY to use live Paystack verification. Do not set a test key in production.
PAYMENTS_MODE=
PAYSTACK_SECRET_KEY=
# Optional. The server uses the secret key. This public key is not required for the redirect flow.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Email through Resend. If either value is missing, orders are saved and no email is pretended.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# Optional GA4 measurement ID. The script loads only after the visitor accepts analytics.
NEXT_PUBLIC_ANALYTICS_ID=
